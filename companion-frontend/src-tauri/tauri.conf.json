{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskAura",
  "version": "0.1.0",
  "identifier": "com.deskaura.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskAura",
        "width": 840,
        "height": 900,
        "minWidth": 240,
        "minHeight": 240,
        "decorations": false,
        "transparent": true,
        "focus": false,
        "focusable": false,
        "alwaysOnTop": false,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "home",
        "url": "/?home=1",
        "title": "DeskAura · 角色工作室",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "center": true,
        "dragDropEnabled": true
      },
      {
        "label": "settings",
        "url": "/?settings=1",
        "title": "DeskAura · 设置",
        "width": 980,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$DESKTOP/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$PICTURE/**",
          "C:/**",
          "D:/**",
          "E:/**",
          "F:/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    },
    "resources": {
      "../../local-models/": "local-models/",
      "binaries/deskaura-backend/": "deskaura-backend/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
